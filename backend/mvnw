#!/usr/bin/env bash
# Maven wrapper script for Smart City Route Finder Backend
set -e

# Detect Java 17+
if [ -n "$JAVA_HOME" ] && [ -x "$JAVA_HOME/bin/java" ]; then
    JAVACMD="$JAVA_HOME/bin/java"
elif [ -x "/usr/lib/jvm/java-21-openjdk-amd64/bin/java" ]; then
    export JAVA_HOME="/usr/lib/jvm/java-21-openjdk-amd64"
    export PATH="$JAVA_HOME/bin:$PATH"
fi

# Detect Maven installation
if command -v mvn >/dev/null 2>&1; then
    MVN_CMD="mvn"
elif [ -x "/tmp/maven/bin/mvn" ]; then
    MVN_CMD="/tmp/maven/bin/mvn"
else
    echo "Error: Maven not found on system." >&2
    exit 1
fi

exec "$MVN_CMD" "$@"

