{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Compile Project",
            "type": "shell",
            "command": "javac -d bin src/*.java",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": ["$javac"]
        },
        {
            "label": "Run Smart City Route Finder",
            "type": "shell",
            "command": "java -cp bin Main",
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "dependsOn": "Compile Project",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "focus": true
            }
        }
    ]
}

